<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      SITUATIONAL EXCEPTIONS (documented in MAINTAINER-README.txt): this project is a
      Roslyn source generator, which the compiler loads in-process, so it MUST target
      netstandard2.0 (not net10.0) - and because netstandard2.0 defaults to C# 7.3,
      LangVersion is pinned (12, as the upstream generator was written against) so the
      file-scoped-namespace and collection-expression source compiles. Nullable stays
      enabled for fidelity with the upstream generator source.

      The generator runs ONLY while CodeBrix.Sdl3 itself is compiled: it writes the
      friendly string/Utf8String overloads, and those are compiled INTO CodeBrix.Sdl3.dll.
      So this project is NOT packed anywhere (no analyzers/ folder in the package) and
      package consumers never load it.

      NoWarn CS1591: ruling D5 of the CodeBrix.Sdl3 plan (2026-10-01) allows it on the
      library and on this generator companion.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>CodeBrix.Sdl3.SourceGeneration</RootNamespace>
    <AssemblyName>CodeBrix.Sdl3.SourceGeneration</AssemblyName>
    <!-- AssemblyVersion must be a valid major.minor.build.revision (each <= 65535).
         Pinned independently of the date-based package version of CodeBrix.Sdl3. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- EnforceExtendedAnalyzerRules ensures the generator follows Roslyn component best practices -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Package versions: LATEST stable, on purpose. The generator is an IIncrementalGenerator
    (ported from upstream's classic ISourceGenerator + ISyntaxReceiver, whose API
    Microsoft.CodeAnalysis.Analyzers 3.11.0+ rejects under EnforceExtendedAnalyzerRules with
    RS1035/RS1042), so nothing holds these references back any more: keep them at the latest
    stable Microsoft.CodeAnalysis.CSharp + Microsoft.CodeAnalysis.Analyzers pair on nuget.org.
    The compiler that runs the generator must be at least the referenced Roslyn version (the
    .NET SDK's own compiler), otherwise the build reports CS9057 and the friendly overloads are
    missing; bump these only to versions the SDK in use already ships.

    Compile-time only: the generator runs while CodeBrix.Sdl3 itself compiles and its output is
    compiled into CodeBrix.Sdl3.dll. It is never packed (IsPackable false, no analyzers/ folder in
    the CodeBrix.Sdl3 package), and these packages are PrivateAssets="all", so neither the
    generator nor Microsoft.CodeAnalysis ever becomes a dependency of the package.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
