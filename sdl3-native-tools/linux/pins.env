# ==============================================================================================
# pins.env - EVERY version / digest / option pin used by sdl3-native-tools/linux.
# Edit here only. build.sh and container-build.sh both source this file and echo the resolved
# values at the top of every run, so a build log always says exactly what it used.
# ==============================================================================================

# --- Container images -------------------------------------------------------------------------
# The manylinux images exist to fix the glibc baseline. Building on a modern desktop distro
# bakes THAT distro's glibc version into the .so, and glibc symbol versioning is forward-only,
# so the library would then refuse to load on anything older - a failure that only shows up on
# a user's machine.
#
#   image                                  glibc  runs on
#   manylinux_2_28_x86_64                  2.28   Debian 10+, Ubuntu 20.04+, RHEL 8+
#   manylinux_2_28_aarch64                 2.28   every 64-bit Raspberry Pi OS, Ubuntu 20.04+
#   manylinux_2_39_riscv64                 2.39   Ubuntu 24.04+, Debian 13+ (in practice every
#                                                 riscv64 distro is newer than this)
#
# These are the same three images, at the same dated tag and the same digests, that
# CodeBrix.VideoPlayback.Dav1d, CodeBrix.Ollama and CodeBrix.Audio pin, so every CodeBrix Linux
# native comes from one base userland. The digest is what the build actually pins: the dated
# tag is there so a human can see which image generation it is, but the FROM line in every
# Containerfile resolves to the digest, so an upstream retag cannot silently change the
# toolchain under a rebuild.
IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64:2026.07.19-1
IMAGE_X64_DIGEST=sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
IMAGE_ARM64=quay.io/pypa/manylinux_2_28_aarch64:2026.07.19-1
IMAGE_ARM64_DIGEST=sha256:162c81dfd3efc710732a571717d3c916a6945ebf279e879ddee3243af96fe46f
IMAGE_RISCV64=quay.io/pypa/manylinux_2_39_riscv64:2026.07.19-1
IMAGE_RISCV64_DIGEST=sha256:04b3acc69a6cebb10ac1252587d202acce6445d91c783d3f92229bb2b2483069

# The derived images this tooling builds ON TOP of those (base + cmake + ninja + the SDL
# backend -devel headers). Building one is the documented "install the tools on the build
# machine" step and is the ONLY step that uses the network; the actual library build then runs
# with --network none.
DERIVED_IMAGE_PREFIX=codebrix-sdl3-build

# --- Build tools installed into the derived images ---------------------------------------------
# cmake and ninja as PyPI wheels, pinned exactly (the same pins as CodeBrix.Ollama's
# llama-native-tools, which proved riscv64 wheels exist for both). They are installed from the
# manylinux image's own CPython (PYTHON_IN_IMAGE). SDL needs cmake >= 3.16.
CMAKE_VERSION=4.4.3
NINJA_VERSION=1.13.2
PYTHON_IN_IMAGE=/opt/python/cp313-cp313/bin/python

# --- The SDL backend headers ---------------------------------------------------------------------
# SDL is built with SDL_DEPS_SHARED=ON: it dlopen()s every windowing / audio / input library at
# RUN time and links none of them, so the shipped .so needs nothing beyond glibc. But it still
# needs each backend's HEADERS at COMPILE time, or CMake silently switches that backend off.
# The Containerfiles install these from the image's own dnf repositories. REQUIRED packages
# fail the image build if absent - without them the library would be useless on a desktop.
# OPTIONAL packages are installed when the image's repositories have them and recorded either
# way in /usr/local/share/codebrix-sdl3-build/packages.txt inside the image, which every build
# copies into its BUILD-INFO.txt. The CMake feature summary in BUILD-INFO.txt is the final word
# on which backends were compiled in.
SDL_DEVEL_REQUIRED="libX11-devel libXext-devel libXrandr-devel libXcursor-devel libXi-devel libXfixes-devel libxkbcommon-devel wayland-devel mesa-libGL-devel mesa-libEGL-devel alsa-lib-devel pulseaudio-libs-devel dbus-devel systemd-devel"
SDL_DEVEL_OPTIONAL="libXScrnSaver-devel libXtst-devel wayland-protocols-devel libdecor-devel mesa-libgbm-devel libdrm-devel pipewire-devel ibus-devel libusb1-devel libusbx-devel jack-audio-connection-kit-devel pipewire-jack-audio-connection-kit-devel sndio-devel fribidi-devel libthai-devel liburing-devel"

# --- Vendored source (in-repo; nothing is fetched at build time) --------------------------------
SDL_DIR=SDL
SDL_VERSION=3.5.0
SDL_COMMIT=a8591d943b7079b17fdd018dc04ec9c71dc94ae4
SDL_COMMIT_SUBJECT="Fix #15985"
SDL_SONAME=libSDL3.so.0
# SDL derives SDL_GetRevision() from `git describe` when it can; the scratch copy has no .git, so
# the revision is pinned here instead - to exactly the string ppy's binaries of this commit carry.
SDL_REVISION_STRING=SDL-3.5.0-a8591d9

# --- The shipped library ----------------------------------------------------------------------
# DllImport("SDL3") on .NET probes runtimes/<rid>/native/libSDL3.so - an UNVERSIONED name - and
# does not follow sonames. The build produces libSDL3.so.0.<x>.<y> plus symlinks; the package
# ships ONE regular file called libSDL3.so. The SONAME libSDL3.so.0 stays inside it, as built.
LIB_NAME=libSDL3.so
LICENSE_FILE_NAME=LICENSE-SDL3.txt

# --- SDL CMake options --------------------------------------------------------------------------
#   -GNinja                        as ppy's CI matrix for every Linux RID
#   CMAKE_BUILD_TYPE=Release       as ppy's CI (BUILD_TYPE: Release)
#   SDL_SHARED=ON SDL_STATIC=OFF   as ppy's External/build.sh: one shared library, no archive
#   SDL_TEST_LIBRARY=OFF SDL_TESTS=OFF SDL_EXAMPLES=OFF
#                                  only the library; the gate's smoke test is our own C file
#   SDL_INSTALL=OFF                nothing is installed anywhere; the .so is collected from the
#                                  build tree
#   SDL_DEPS_SHARED=ON             every backend is dlopen()ed at run time (also SDL's default;
#                                  stated so a future default change cannot slip in)
#   SDL_RPATH=OFF                  SDL's default on Linux is ON; the gate requires no RPATH or
#                                  RUNPATH in a library that lands in somebody else's app folder
#   SDL_REVISION=...               see SDL_REVISION_STRING above
# CMAKE_C_FLAGS (set by container-build.sh) adds -ffile-prefix-map so the scratch paths of the
# build do not end up in the binary, which is what makes repeat builds byte-identical.
SDL_CMAKE_OPTIONS="-DCMAKE_BUILD_TYPE=Release -DSDL_SHARED=ON -DSDL_STATIC=OFF -DSDL_TEST_LIBRARY=OFF -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF -DSDL_INSTALL=OFF -DSDL_DEPS_SHARED=ON -DSDL_RPATH=OFF"

# --- Per-architecture additions ------------------------------------------------------------------
# riscv64: the Rocky Linux 10 base image has NO libXScrnSaver-devel (RHEL 10 dropped the package),
#   and SDL treats a wanted-but-missing X11 extension as a configure ERROR, not a silent OFF. So the
#   XScreenSaver extension is switched off explicitly for this one RID. Consequence: on X11 SDL
#   cannot use XScreenSaverSuspend() to hold off the screensaver; SDL_DisableScreenSaver() still
#   works through the D-Bus org.freedesktop.ScreenSaver inhibit (SDL_DBUS is ON), which is the path
#   current desktops use. Found by the first riscv64 run, 2026-10-01.
#
# x64 / arm64: the AlmaLinux 8 images package no libdecor-devel, so the libdecor HEADER is vendored
#   in linux/vendored-headers/libdecor-0/ (libdecor 0.2.2, MIT - see its UPSTREAM.txt; Jeremy's
#   ruling 2026-10-01) with a pkg-config stub. SDL_VENDORED_PKGCONFIG_<ARCH> (below) puts that
#   folder on PKG_CONFIG_PATH; -DDECOR_0_LIB=libdecor-0.so.0 tells SDL the soname to dlopen(), which
#   SDL would otherwise try to read from an installed libdecor-0.so (there is deliberately none:
#   no libdecor library is linked, and the gate proves libdecor is not in NEEDED).
#   riscv64 gets libdecor-devel 0.2.2 from its own image and uses neither.
SDL_CMAKE_OPTIONS_X64="-DDECOR_0_LIB=libdecor-0.so.0"
SDL_CMAKE_OPTIONS_ARM64="-DDECOR_0_LIB=libdecor-0.so.0"
SDL_CMAKE_OPTIONS_RISCV64="-DSDL_X11_XSCRNSAVER=OFF"

# Vendored pkg-config folders (relative to sdl3-native-tools/) prepended to PKG_CONFIG_PATH inside
# the container, per architecture. Empty = use only the image's own packages.
SDL_VENDORED_PKGCONFIG_X64="linux/vendored-headers/libdecor-0"
SDL_VENDORED_PKGCONFIG_ARM64="linux/vendored-headers/libdecor-0"
SDL_VENDORED_PKGCONFIG_RISCV64=""

# --- Verification gate ---------------------------------------------------------------------------
# The highest GLIBC_x.y symbol version the shipped .so may reference. This IS the oldest system
# the binary can load on, so it is checked, not merely reported.
GLIBC_MAX_X64=2.28
GLIBC_MAX_ARM64=2.28
GLIBC_MAX_RISCV64=2.39

# Shared libraries the .so is allowed to depend on. Anything else is a gate failure: it would
# mean the package demands a library be installed on the user's machine. With SDL_DEPS_SHARED
# every X11 / Wayland / audio / udev library is dlopen()ed, so none of them may appear here.
ALLOWED_DEPS="libc.so.6 libm.so.6 libpthread.so.0 libdl.so.2 librt.so.1 ld-linux-x86-64.so.2 ld-linux-aarch64.so.1 ld-linux-riscv64-lp64d.so.1"

# Functions the shipped library must export (a sample of the C API the managed bindings call;
# the full export count is recorded in BUILD-INFO.txt).
REQUIRED_SYMBOLS="SDL_Init SDL_Quit SDL_GetVersion SDL_GetRevision SDL_GetError SDL_SetHint SDL_CreateWindow SDL_DestroyWindow SDL_CreateRenderer SDL_DestroyRenderer SDL_PollEvent SDL_GetCurrentVideoDriver SDL_GetNumVideoDrivers SDL_GetVideoDriver SDL_GetNumAudioDrivers SDL_GetAudioDriver"

# Sonames that must appear in the shipped library as dlopen() targets - one per backend that
# MUST be compiled in on every Linux RID (X11, Wayland + libdecor + xkbcommon, EGL, ALSA,
# PulseAudio, udev, D-Bus). A missing one fails the gate: it means CMake switched that backend off.
REQUIRED_DLOPEN_SONAMES="libX11.so.6 libwayland-client.so.0 libdecor-0.so.0 libxkbcommon.so.0 libEGL.so.1 libasound.so.2 libpulse.so.0 libudev.so.1 libdbus-1.so.3"

# The version number the smoke test must read back from SDL_GetVersion():
# SDL_VERSIONNUM(3, 5, 0) = 3 * 1000000 + 5 * 1000 + 0.
SDL_VERSION_NUM=3005000
